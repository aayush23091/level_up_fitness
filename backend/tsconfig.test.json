{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "types": [
      "node",
      "jest"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "rootDir": "src"
  },
  "include": ["src"]
}
